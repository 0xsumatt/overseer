# Nothing auto-loads this file (config.py reads plain os.environ): export these
# from your shell/systemd unit, or run via `uv run --env-file .env ...`.

DATABASE_URL=
DISCORD_WEBHOOK_URL=
FLASK_SECRET_KEY=
# Leave these disabled for direct local Flask development. The production
# systemd service enables both after placing Gunicorn behind Nginx and HTTPS.
OVERSEER_PROXY_HOPS=0
OVERSEER_SECURE_COOKIES=false
OVERSEER_SYMBOLS_FILE=symbols.toml
OVERSEER_SPREAD_ALERT_APR=25
OVERSEER_SPREAD_CONFIRM_MINUTES=10
